# Public browser configuration only. Copy to .env.local.
# Local backend. On Vercel leave unset to use same-origin /api.
VITE_API_URL=http://localhost:8000
# Optional public CARTO basemap key; without it, OpenStreetMap tiles are used.
VITE_CARTO_API_KEY=
# Optional: use your own Supabase project URL and publishable/anon key.
# Enable row-level security; never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
