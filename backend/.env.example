# Server-only settings. Copy to backend/.env; never use a VITE_ prefix here.
# Optional: chat returns a clear unavailable response until configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
SITE_URL=http://localhost:5173
# Exact frontend origins, separated by commas; add your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
